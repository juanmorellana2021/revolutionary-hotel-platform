{
  "name": "ai-dev-engineer",
  "displayName": "AI Dev Engineer",
  "description": "Your senior dev code reviewer - scans security, architecture, error handling, database, performance & API design. Auto-fix with best practices.",
  "version": "2.0.0",
  "publisher": "juanmorellana",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Linters",
    "Testing",
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "developer",
    "security",
    "code quality",
    "auto-fix",
    "best practices",
    "javascript",
    "php"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:php",
    "onLanguage:typescript"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiDevEngineer.scanFile",
        "title": "AI Dev: Scan Current File"
      },
      {
        "command": "aiDevEngineer.scanWorkspace",
        "title": "AI Dev: Scan Entire Workspace"
      },
      {
        "command": "aiDevEngineer.autoFix",
        "title": "AI Dev: Auto-Fix Issues"
      },
      {
        "command": "aiDevEngineer.generateTests",
        "title": "AI Dev: Generate Tests"
      },
      {
        "command": "aiDevEngineer.showDashboard",
        "title": "AI Dev: Show Dashboard"
      },
      {
        "command": "aiDevEngineer.loadContext",
        "title": "AI Dev: Load Project Context (Copy to Clipboard)"
      }
    ],
    "chatParticipants": [
      {
        "id": "ai-dev-engineer.context",
        "name": "context",
        "fullName": "AI Dev Context",
        "description": "Loads your project context automatically",
        "isSticky": true
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId == javascript || resourceLangId == php || resourceLangId == typescript",
          "command": "aiDevEngineer.scanFile",
          "group": "aidev@1"
        },
        {
          "when": "resourceLangId == javascript || resourceLangId == php || resourceLangId == typescript",
          "command": "aiDevEngineer.autoFix",
          "group": "aidev@2"
        }
      ],
      "explorer/context": [
        {
          "command": "aiDevEngineer.scanWorkspace",
          "group": "aidev"
        }
      ]
    },
    "keybindings": [
      {
        "command": "aiDevEngineer.loadContext",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus"
      },
      {
        "command": "aiDevEngineer.scanFile",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "AI Dev Engineer",
      "properties": {
        "aiDevEngineer.licenseKey": {
          "type": "string",
          "default": "",
          "description": "Your Pro license key"
        },
        "aiDevEngineer.autoScanOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically scan files when saved"
        },
        "aiDevEngineer.severity": {
          "type": "string",
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "description": "Minimum severity to show warnings"
        }
      }
    }
  },
  "scripts": {
    "test": "node ./test/runTest.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/juanmorellana2021/revolutionary-hotel-platform"
  },
  "license": "MIT"
}
