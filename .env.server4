# AiniFlow Server (Social AINI - Server 4) Environment Configuration

# Server
PORT=3000
NODE_ENV=production

# PostgreSQL Database
DB_USER=postgres
DB_HOST=localhost
DB_NAME=aini_platform
DB_PASSWORD=
DB_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secret (generate a strong random key)
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# Twilio (for SMS verification)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# CORS
CORS_ORIGIN=*

# Hotel Servers (for SSO integration)
HOTEL_SERVER_1=http://108.175.12.152
HOTEL_SERVER_2=http://your_server_2_ip
HOTEL_SERVER_3=http://your_server_3_ip

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/var/www/aini-platform/uploads

# Feature Flags
ENABLE_SMS_VERIFICATION=false
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_EMAIL_NOTIFICATIONS=false
